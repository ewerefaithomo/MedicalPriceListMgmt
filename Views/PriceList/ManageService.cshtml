@model MedicalPriceListApp.Models.PriceList

@{
    ViewData["Title"] = "Manage Medical Service";

    var services =
        ViewBag.Services as IEnumerable<MedicalPriceListApp.Models.PriceList>
        ?? Enumerable.Empty<MedicalPriceListApp.Models.PriceList>();

    bool serviceSelected =
        !string.IsNullOrWhiteSpace(Model?.BANK_CODE);
}


<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-success mb-1">

                <i class="bi bi-pencil-square me-2"></i>

                Manage Medical Service

            </h2>

            <p class="text-muted mb-0">

                University of Benin Teaching Hospital

            </p>

        </div>


        <div class="mt-3 mt-md-0">

            <a asp-controller="PriceList"
               asp-action="Index"
               class="btn btn-outline-success me-2">

                <i class="bi bi-speedometer2 me-1"></i>

                Dashboard

            </a>


            <a asp-controller="PriceList"
               asp-action="ExitManagement"
               class="btn btn-outline-danger">

                <i class="bi bi-box-arrow-right me-1"></i>

                Exit Management

            </a>

        </div>

    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible
                        fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>
                @TempData["Success"]
            </strong>


            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         ERROR MESSAGE
         ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible
                        fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            <strong>
                @TempData["Error"]
            </strong>


            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         SELECT SERVICE
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="bi bi-search me-2"></i>

                Select Medical Service

            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="PriceList"
                  asp-action="ManageService"
                  method="get">

                <div class="row align-items-end g-3">

                    <div class="col-md-9">

                        <label for="bankCode"
                               class="form-label fw-semibold">

                            Service

                        </label>


                        <select id="bankCode"
                                name="bankCode"
                                class="form-select form-select-lg">

                            <option value="">

                                -- Select a Medical Service --

                            </option>


                            @foreach (var service in services)
                            {
                                if (service.BANK_CODE == Model?.BANK_CODE)
                                {
                                    <option value="@service.BANK_CODE"
                                            selected>

                                        @service.SERVICES
                                        -
                                        @service.BANK_CODE

                                    </option>
                                }
                                else
                                {
                                    <option value="@service.BANK_CODE">

                                        @service.SERVICES
                                        -
                                        @service.BANK_CODE

                                    </option>
                                }
                            }

                        </select>


                        <div class="form-text">

                            Select the service you want to update
                            or delete.

                        </div>

                    </div>


                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">

                            <i class="bi bi-folder2-open me-2"></i>

                            Load Service

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (serviceSelected)
    {
        <!-- =====================================================
             SERVICE INFORMATION
             ===================================================== -->

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">

                    <i class="bi bi-clipboard2-pulse me-2"></i>

                    Service Information

                </h5>

            </div>


            <div class="card-body p-4">


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- =============================================
                     UPDATE FORM
                     ============================================= -->

                <form asp-controller="PriceList"
                      asp-action="UpdateService"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- Original Bank Code -->
                    <input type="hidden"
                           name="originalBankCode"
                           value="@Model.BANK_CODE" />


                    <div class="row g-4">


                        <!-- BANK CODE -->
                        <div class="col-md-6">

                            <label asp-for="BANK_CODE"
                                   class="form-label fw-semibold">

                                Bank Code

                                <span class="text-danger">
                                    *
                                </span>

                            </label>


                            <input asp-for="BANK_CODE"
                                   class="form-control"
                                   autocomplete="off" />


                            <div class="form-text">

                                Bank Code can be changed if necessary,
                                provided the new code is not already in use.

                            </div>


                            <span asp-validation-for="BANK_CODE"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SERVICE -->
                        <div class="col-md-6">

                            <label asp-for="SERVICES"
                                   class="form-label fw-semibold">

                                Service

                                <span class="text-danger">
                                    *
                                </span>

                            </label>


                            <input asp-for="SERVICES"
                                   class="form-control"
                                   autocomplete="off" />


                            <span asp-validation-for="SERVICES"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CURRENT PRICE -->
                        <div class="col-md-6">

                            <label asp-for="CURRENT_PRICE"
                                   class="form-label fw-semibold">

                                Current Price

                                <span class="text-danger">
                                    *
                                </span>

                            </label>


                            <div class="input-group">

                                <span class="input-group-text">
                                    ₦
                                </span>


                                <input asp-for="CURRENT_PRICE"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control" />

                            </div>


                            <span asp-validation-for="CURRENT_PRICE"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- REVENUE FUND -->
                        <div class="col-md-6">

                            <label asp-for="REVENUE_GENERATING_FUND"
                                   class="form-label fw-semibold">

                                Revenue Generating Fund

                                <span class="text-danger">
                                    *
                                </span>

                            </label>


                            <input asp-for="REVENUE_GENERATING_FUND"
                                   class="form-control"
                                   autocomplete="off" />


                            <span asp-validation-for="REVENUE_GENERATING_FUND"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DEPARTMENT -->
                        <div class="col-md-6">

                            <label asp-for="DEPARTMENT"
                                   class="form-label fw-semibold">

                                Department

                                <span class="text-danger">
                                    *
                                </span>

                            </label>


                            <input asp-for="DEPARTMENT"
                                   class="form-control"
                                   autocomplete="off" />


                            <span asp-validation-for="DEPARTMENT"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- =========================================
                         ACTION BUTTONS
                         ========================================= -->

                    <div class="d-flex flex-wrap gap-2">


                        <!-- UPDATE -->
                        <button type="submit"
                                class="btn btn-success px-4">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Update Service

                        </button>


                        <!-- DELETE -->
                        <button type="button"
                                class="btn btn-danger px-4"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteServiceModal">

                            <i class="bi bi-trash-fill me-2"></i>

                            Delete Service

                        </button>


                        <!-- CLEAR -->
                        <a asp-controller="PriceList"
                           asp-action="ManageService"
                           class="btn btn-outline-secondary px-4">

                            <i class="bi bi-arrow-clockwise me-2"></i>

                            Clear

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
             DELETE CONFIRMATION MODAL
             ===================================================== -->

        <div class="modal fade"
             id="deleteServiceModal"
             tabindex="-1"
             aria-labelledby="deleteServiceModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">


                    <div class="modal-header bg-danger text-white">

                        <h5 class="modal-title"
                            id="deleteServiceModalLabel">

                            <i class="bi bi-exclamation-triangle-fill me-2"></i>

                            Confirm Deletion

                        </h5>


                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p class="mb-2">

                            Are you sure you want to delete this
                            medical service?

                        </p>


                        <div class="alert alert-warning">

                            <strong>
                                @Model.SERVICES
                            </strong>

                            <br />

                            Bank Code:
                            <strong>
                                @Model.BANK_CODE
                            </strong>

                            <br />

                            Department:
                            <strong>
                                @Model.DEPARTMENT
                            </strong>

                        </div>


                        <p class="text-danger mb-0">

                            <i class="bi bi-info-circle me-1"></i>

                            This action cannot be undone.

                        </p>

                    </div>


                    <div class="modal-footer">


                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <form asp-controller="PriceList"
                              asp-action="DeleteService"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="bankCode"
                                   value="@Model.BANK_CODE" />


                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash-fill me-1"></i>

                                Yes, Delete Service

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =========================================================
         INFORMATION
         ========================================================= -->

    <div class="alert alert-info mt-4">

        <i class="bi bi-info-circle-fill me-2"></i>

        <strong>Management Instructions:</strong>

        Select a medical service from the list above. The existing
        Bank Code, Current Price, Revenue Generating Fund and
        Department will be displayed. Make the required changes
        and click <strong>Update Service</strong>, or click
        <strong>Delete Service</strong> to remove the record.

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}