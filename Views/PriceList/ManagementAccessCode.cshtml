@{
    ViewData["Title"] = "Price List Management Access";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-success text-white text-center py-3">

                    <h4 class="mb-0">
                        <i class="bi bi-shield-lock-fill me-2"></i>
                        Price List Management
                    </h4>

                </div>

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <i class="bi bi-key-fill text-success"
                           style="font-size: 60px;">
                        </i>

                        <h5 class="fw-bold mt-3">
                            Access Required
                        </h5>

                        <p class="text-muted mb-0">
                            Please enter the Access Code to update
                            or delete a medical service.
                        </p>

                    </div>


                    <form asp-controller="PriceList"
                          asp-action="VerifyManagementAccessCode"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label for="accessCode"
                                   class="form-label fw-semibold">

                                Access Code

                            </label>


                            <input type="password"
                                   id="accessCode"
                                   name="accessCode"
                                   class="form-control form-control-lg text-center"
                                   placeholder="Enter Access Code"
                                   autocomplete="off"
                                   autofocus />


                            <span class="text-danger">
                                @Html.ValidationMessage("accessCode")
                            </span>

                        </div>


                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                <i class="bi bi-unlock-fill me-2"></i>
                                Continue

                            </button>


                            <a asp-controller="PriceList"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Dashboard

                            </a>

                        </div>

                    </form>

                </div>


                <div class="card-footer bg-light text-center">

                    <small class="text-muted">

                        University of Benin Teaching Hospital (UBTH)
                        <br />

                        ICT Department

                    </small>

                </div>

            </div>

        </div>

    </div>

</div>