<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - UBTH Medical Price List
    </title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        body {
            background-color: #f5f8f6;
            min-height: 100vh;
        }

        /* UBTH Header */
        .ubth-header {
            background-color: #198754;
            color: white;
        }

        .ubth-brand {
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .ubth-subtitle {
            font-size: 0.85rem;
            opacity: 0.9;
        }

        /* Navigation */
        .navbar-nav .nav-link {
            color: white !important;
            font-weight: 500;
        }

            .navbar-nav .nav-link:hover {
                background-color: rgba(255,255,255,0.15);
                border-radius: 5px;
            }

        /* Main Content */
        main {
            min-height: calc(100vh - 130px);
        }

        /* Footer */
        .ubth-footer {
            background-color: #198754;
            color: white;
        }

            .ubth-footer small {
                opacity: 0.95;
            }

    </style>

</head>

<body>

    <!-- ============================= -->
    <!-- HEADER / NAVIGATION -->
    <!-- ============================= -->

    <header>

        <nav class="navbar navbar-expand-lg ubth-header shadow-sm">

            <div class="container-fluid px-4">

                <!-- Brand -->
                <a class="navbar-brand text-white ubth-brand"
                   asp-controller="PriceList"
                   asp-action="Index">

                    <i class="bi bi-hospital me-2"></i>

                    UBTH Medical Price List

                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto">

                        <!-- Dashboard -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PriceList"
                               asp-action="Index">

                                <i class="bi bi-speedometer2 me-1"></i>
                                Dashboard

                            </a>

                        </li>

                        <!-- View Price List -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PriceList"
                               asp-action="ViewList">

                                <i class="bi bi-list-ul me-1"></i>
                                Price List

                            </a>

                        </li>

                        <!-- Add Service -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PriceList"
                               asp-action="Create">

                                <i class="bi bi-plus-circle me-1"></i>
                                Add Service

                            </a>

                        </li>

                        <!-- Manage -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PriceList"
                               asp-action="ModifyList">

                                <i class="bi bi-pencil-square me-1"></i>
                                Manage

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ============================= -->
    <!-- MAIN CONTENT -->
    <!-- ============================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->

    <footer class="ubth-footer py-3 mt-4">

        <div class="container-fluid text-center">

            <small>

                <strong>
                    University of Benin Teaching Hospital (UBTH)
                </strong>

                <br />

                Medical Price List Management System

                <br />

                <span>
                    ICT Department
                </span>

            </small>

        </div>

    </footer>


    <!-- ============================= -->
    <!-- JAVASCRIPT -->
    <!-- ============================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>